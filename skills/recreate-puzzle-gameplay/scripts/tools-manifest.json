    {
      "id": "dotnet",
      "version": "10.0+ runtime (manual hint pins 10.0.15)",
      "folder": null,
      "required": true,
      "post": "none",
      "detect": [],
      "detect_command": "dotnet",
      "min_runtime": {
        "name": "Microsoft.NETCore.App",
        "major": 10
      },
      "detect_extra": {
        "windows": [
          "{root}/dotnet/dotnet.exe",
          "%ProgramFiles%/dotnet/dotnet.exe",
          "%LOCALAPPDATA%/Microsoft/dotnet/dotnet.exe"
        ],
        "linux": [
          "{root}/dotnet/dotnet",
          "/usr/share/dotnet/dotnet",
          "/usr/lib/dotnet/dotnet",
          "~/.dotnet/dotnet"
        ],
        "macos": [
          "{root}/dotnet/dotnet",
          "/usr/local/share/dotnet/dotnet",
          "/opt/homebrew/bin/dotnet",
          "~/.dotnet/dotnet"
        ]
      },
      "manual": {
        "windows": "stop: hand to the user \u2014 in PowerShell, no admin: download https://dot.net/v1/dotnet-install.ps1, then run: powershell -NoProfile -ExecutionPolicy Bypass -File dotnet-install.ps1 -Runtime dotnet -Version 10.0.15 -InstallDir \"{root}/dotnet\" -NoPath ; then re-run ensure_tools.py",
        "linux": "stop: hand to the user \u2014 no root needed: download https://dot.net/v1/dotnet-install.sh, then run: bash dotnet-install.sh --runtime dotnet --version 10.0.15 --install-dir \"{root}/dotnet\" --no-path ; then re-run ensure_tools.py",
        "macos": "stop: hand to the user \u2014 no admin needed: download https://dot.net/v1/dotnet-install.sh, then run: bash dotnet-install.sh --runtime dotnet --version 10.0.15 --install-dir \"{root}/dotnet\" --no-path ; then re-run ensure_tools.py"
      }
    },
